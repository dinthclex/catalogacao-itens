  "scripts": [
    {
      "id": "automation-raio-x",
      "nome": "👁️ Modo Raio-X (exemplo original)",
      "codigo": "// Exemplo: \"Modo Raio-X\" — oculta paredes/vigas/portas e faz os PCs levitarem.\n// Clique em \"▶️ Executar\" pra ver o efeito, e em \"↩️ Desexecutar\" pra desfazer.\n\n// 1) Oculta tudo que tiver as classes .parede, .viga ou .porta (vírgula = OU).\nSelect('.parede, .viga, .porta').hide();\n\n// 2) Faz os objetos com a classe .pc levitarem — animação de posição, em loop\n//    (yoyo: sobe e desce; repeat: Infinity = sem parar até Desexecutar).\nSelect('.pc').animate({ elevacao: 0.4 }, 900, {\n  easing: TWEEN.Easing.Quadratic.InOut,\n  yoyo: true,\n  repeat: Infinity,\n});\n\n// 3) Só pra chamar atenção: pisca a opacidade dos PCs também.\nSelect('.pc').blink({ min: 0.4, duration: 500 });",
      "criadoEm": "2026-09-26T22:20:01.480Z",
      "atualizadoEm": "2026-09-26T22:20:01.480Z"
    },
    {
      "id": "automation-hierarquia-gabinete-ap",
      "nome": "🗄️ Hierarquia: Gabinete e Access Point",
      "codigo": "// Exemplo da HIERARQUIA real tipo-DOM (`paiId`) — pedido verbatim:\n// \"poder selecionar o Gabinete via código e o que há dentro dele\n// [...] abrir a tampa do Gabinete e ligá-lo/desligá-lo [...] poder\n// selecionar o Access Point e ligá-lo/desligá-lo, fazer a sua\n// varredura ser iniciada e fazer com que apareça.\"\n\n// 1) Seleciona o(s) Gabinete(s) (classe .pc) e liga.\nSelect('gabinete.pc').ligar();\n\n// 2) `.filhos()` pega o que há DENTRO do Gabinete — hoje, a tampa\n//    (paiId apontando pra ele); qualquer peça nova que ganhar\n//    `paiId` do Gabinete também aparece aqui automaticamente.\nSelect('gabinete.pc').filhos().each((peca) => {\n  console.log('Peça dentro do Gabinete:', peca.nome, peca.classes);\n});\n\n// 3) Abre a tampa — funciona chamado no Gabinete OU direto na tampa.\nSelect('gabinete.pc').abrirTampa();\n\n// 4) Access Point — liga, inicia a varredura de verdade (raytracing\n//    3D real, se \"Ver em 3D\" ou a Miniatura 3D estiverem abertos —\n//    ver nota grande em `.iniciarVarredura()`, js/automation.js) e\n//    faz aparecer (fade-in de opacidade).\nSelect('access_point').desaparecer(0); // garante que começa \"invisível\" pro fade-in fazer sentido\nSelect('access_point').ligar();\nSelect('access_point').iniciarVarredura();\nSelect('access_point').aparecer(600);",
      "criadoEm": "2026-09-26T22:20:01.480Z",
      "atualizadoEm": "2026-09-26T22:20:01.480Z"
    },
    {
      "id": "automation-manutencao-hidraulica-eletrica",
      "nome": "🔧 Modo Manutenção Hidráulica/Elétrica",
      "codigo": "// \"Modo Manutenção\" — apaga (esmaece) tudo que NÃO for parte da\n// infraestrutura hidráulica/elétrica, e destaca só o que é, pra\n// facilitar achar tubos/quadros/tomadas no meio do resto do mapa.\n// Marque os objetos relevantes com as classes .hidraulica e/ou\n// .eletrica (painel do objeto → campo \"Classes\", ou \"🏷️ Grupos\").\n\n// 1) Esmaece TUDO que não seja infraestrutura.\nSelect('*:not(.hidraulica):not(.eletrica)').opacity(0.12);\n\n// 2) Destaca (anel dourado) a infraestrutura hidráulica e elétrica.\nSelect('.hidraulica, .eletrica').highlight();\n\n// 3) Pisca bem sutil só a elétrica, pra diferenciar visualmente da\n//    hidráulica (que fica destacada, mas fixa).\nSelect('.eletrica').blink({ min: 0.55, duration: 700 });",
      "criadoEm": "2026-09-26T22:20:01.480Z",
      "atualizadoEm": "2026-09-26T22:20:01.480Z"
    },
    {
      "id": "automation-isolar-selecao-atendida",
      "nome": "✅ Isolar Seleção Atendida",
      "codigo": "// \"Isolar Seleção Atendida\" — pensado pra manutenção/checklist:\n// depois de marcar cada item já resolvido/vistoriado com a classe\n// .atendido, este script ESCONDE tudo que já foi atendido e deixa\n// só o que falta visível — \"isola\" o trabalho restante.\n\nSelect('.atendido').hide();\n\n// Opcional: destaca em vermelho (via opacidade bem baixa dos já\n// atendidos já dá o contraste; aqui só reforça o que sobrou visível).\nSelect('*:not(.atendido)').highlight();",
      "criadoEm": "2026-09-26T22:20:01.480Z",
      "atualizadoEm": "2026-09-26T22:20:01.480Z"
    },
    {
      "id": "automation-alerta-incendio-evacuacao",
      "nome": "🚨 Alerta de Incêndio/Evacuação",
      "codigo": "// \"Alerta de Incêndio/Evacuação\" — abre as portas (rota de saída),\n// faz saídas/extintores piscarem em destaque (classes .saida e\n// .extintor) e esmaece o resto do mapa, pra guiar o olho direto\n// pra rota de evacuação. Ver nota sobre luz ambiente no comentário\n// grande de `SCRIPT_TEMPLATES`, no topo deste arquivo — este\n// exemplo simula o \"vermelho de alerta\" com `.highlight()`/\n// `.blink()` nos próprios objetos, não na luz da cena.\n\n// 1) Abre (gira 90°) todas as portas — rota livre pra evacuação.\nSelect('porta').rotate(90);\n\n// 2) Saídas de emergência e extintores piscam em destaque.\nSelect('.saida, .extintor').highlight();\nSelect('.saida, .extintor').blink({ min: 0.3, duration: 350 });\n\n// 3) Esmaece o resto, pra não competir visualmente com a rota.\nSelect('*:not(.saida):not(.extintor):not(porta)').opacity(0.25);",
      "criadoEm": "2026-09-26T22:20:01.480Z",
      "atualizadoEm": "2026-09-26T22:20:01.480Z"
    },
    {
      "id": "automation-simulacao-falha-equipamento",
      "nome": "⚠️ Simulação de Falha de Equipamento",
      "codigo": "// \"Simulação de Falha de Equipamento\" — pisca em vermelho (opacidade)\n// só o(s) equipamento(s) marcado(s) com a classe .em-falha (marque\n// o servidor/rack/equipamento específico com essa classe antes de\n// executar — ex.: um rack específico que \"quebrou\" no treinamento),\n// e destaca o resto dos equipamentos do MESMO andar em opacidade\n// normal, pra dar contexto de onde ele está.\n\n// 1) Pisca rápido (alerta) só quem está marcado como em falha.\nSelect('.em-falha').highlight();\nSelect('.em-falha').blink({ min: 0.2, duration: 250 });\n\n// 2) Esmaece TUDO que não seja equipamento de rede/rack — só pra\n//    contextualizar o entorno sem distrair do alerta.\nSelect('*:not(.servidor):not(.rack):not(.em-falha)').opacity(0.3);",
      "criadoEm": "2026-09-26T22:20:01.480Z",
      "atualizadoEm": "2026-09-26T22:20:01.480Z"
    },
    {
      "id": "automation-efeito-explosao",
      "nome": "💥 Efeito de Explosão (Exploded View)",
      "codigo": "// \"Efeito de Explosão/Exploded View\" — afasta cada objeto (classe\n// .pc como exemplo — troque pelo seletor que quiser) verticalmente\n// a partir da posição ATUAL dele (por isso o valor relativo\n// \"+=\", em vez de um número fixo — cada objeto sobe uma distância\n// relativa à posição onde já está, então eles se afastam uns dos\n// outros em vez de se amontoarem no mesmo lugar).\n\nSelect('.pc').each((o, i) => {\n  new TWEEN.Tween(o)\n    .to({ elevacao: (o.elevacao || 0) + 0.6 + i * 0.15 }, 700)\n    .easing(TWEEN.Easing.Back.Out)\n    .delay(i * 60) // efeito \"cascata\" — um depois do outro, não todos juntos\n    .yoyo(true).repeat(1) // sobe e volta — pra ver o efeito sem precisar de \"Desexecutar\" a cada teste\n    .start();\n});",
      "criadoEm": "2026-09-26T22:20:01.480Z",
      "atualizadoEm": "2026-09-26T22:20:01.480Z"
    },
    {
      "id": "automation-animacao-entrada-spawn",
      "nome": "✨ Animação de Entrada (Spawn Effect)",
      "codigo": "// \"Animação de Entrada/Spawn Effect\" — objetos \"nascem\" pequenos e\n// crescem até o tamanho normal, em cascata (um pouco depois do\n// outro) — bom pra uma apresentação/demonstração ao vivo do mapa.\n\nSelect('.pc, .mesa, .cadeira').each((o, i) => {\n  const larguraFinal = o.largura, alturaFinal = o.altura, profFinal = o.profundidade;\n  o.largura = 0.01; o.altura = 0.01; o.profundidade = 0.01; // \"nasce\" minúsculo\n  new TWEEN.Tween(o)\n    .to({ largura: larguraFinal, altura: alturaFinal, profundidade: profFinal }, 500)\n    .easing(TWEEN.Easing.Back.Out)\n    .delay(i * 80)\n    .start();\n});",
      "criadoEm": "2026-09-26T22:20:01.480Z",
      "atualizadoEm": "2026-09-26T22:20:01.480Z"
    }
  ]
}